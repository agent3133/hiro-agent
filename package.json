{
  "name": "hiro-agent",
  "version": "0.9.5",
  "description": "Chat with an AI agent that reads, searches, writes and moves your notes through your own model: a local llama.cpp server or any OpenAI-compatible API. No external CLI.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "agent": "node scripts/run-agent.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "notices": "node scripts/notices.mjs",
    "check-notices": "node scripts/notices.mjs --check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^29.1.1",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  }
}
